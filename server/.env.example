# Server Configuration
PORT=8080
NODE_ENV=development
CORS_ORIGIN=*

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sendtemp?schema=public"

# Storage Configuration ('local' or 's3')
STORAGE_PROVIDER=local
STORAGE_PATH=./tmp/sendtemp-storage
MAX_FILE_SIZE_MB=100

# S3 / Cloudflare R2 Configuration (Required if STORAGE_PROVIDER=s3)
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=sendtemp-storage
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
